{"root":{"data":{"id":"dis81w7d01k0","created":1779759398002,"text":"攻击溯源综述"},"children":[{"data":{"id":"dis822sx34w0","created":1779759412367,"text":"分析路由器、交换机等网络设备及服务器、操作系统等主机系统所产生的日志文件"},"children":[{"data":{"id":"dis82h7kjco0","created":1779759443727,"text":"重构攻击路径"},"children":[]},{"data":{"id":"dis82njc29s0","created":1779759457500,"text":"识别攻击源"},"children":[]}]},{"data":{"id":"dis83nulxcw0","created":1779759536545,"text":"方法","expandState":"expand"},"children":[{"data":{"id":"dis83s9qxww0","created":1779759546168,"text":"传统日志分析"},"children":[{"data":{"id":"dis83yaok4o0","created":1779759559285,"text":"挑战：日志数量庞大格式多变，依赖设备日志完整性和时间同步"},"children":[]}]},{"data":{"id":"dis852i4wgw0","created":1779759646807,"text":"基于网络流量分析和反向追踪"},"children":[{"data":{"id":"dis85dqa7v40","created":1779759671244,"text":"过分析网络流量的特征(如大小、流向、\n协议类型)来识别异常模式，结合威胁情报锁定攻击源，对恶意样本（恶意软件、木马）代码结构、功能模块及加密方式进行深入分析揭露攻击模式实现同源攻击者溯源【43】"},"children":[]}]},{"data":{"id":"dis865kd5fs0","created":1779759731836,"text":"依托多数据整合、创新分析方法、高效协同机制"},"children":[{"data":{"id":"dis873okpzc0","created":1779759806102,"text":"贝叶斯网络：检测僵尸网络的 IRC流量"},"children":[]}]}]},{"data":{"id":"dis8j8vga1k0","created":1779760757772,"text":"技术分类"},"children":[{"data":{"id":"dis8jbgntk80","created":1779760763407,"text":"基于威胁情报的追踪溯源技术：×"},"children":[]},{"data":{"id":"dis8jlfljm80","created":1779760785111,"text":"基于网络攻击链的追踪溯源技术：√"},"children":[]},{"data":{"id":"dis8jv4lq540","created":1779760806214,"text":"基于知识图谱的追踪溯源技术：√"},"children":[]},{"data":{"id":"dis8jvht1ug0","created":1779760807012,"text":"基于序列模式挖掘的追踪溯源技术：×"},"children":[]}]},{"data":{"id":"dis8lh0bdnk0","created":1779760932208,"text":"典型场景"},"children":[{"data":{"id":"dis8ljkayvk0","created":1779760937770,"text":"web攻击"},"children":[{"data":{"id":"dis8logh6280","created":1779760948423,"text":" XSS攻击、SQL 注入、CSRF 攻击、"},"children":[]},{"data":{"id":"dis8lydoisg0","created":1779760970021,"text":"恶意病毒、木马"},"children":[]},{"data":{"id":"dis8mzpq2eg0","created":1779761051291,"text":"分支主题"},"children":[]}]},{"data":{"id":"dis8lmrbkbs0","created":1779760944725,"text":"DDoS攻击"},"children":[]},{"data":{"id":"dis8m841rk00","created":1779760991207,"text":"APT攻击"},"children":[]}]}]},"template":"right","theme":"fresh-blue","version":"1.4.43"}